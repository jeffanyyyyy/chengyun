  "source": "const PF = {\n      fov: 30,            /* 緞帶用的視角；拼貼牆另外用 gridFov */\n      ringDist: 20,       /* 曲線座標原點離鏡頭多遠 */\n      ribbonW: 0.62,      /* 緞帶寬度 = 這個倍數 x 曲線深度上的畫面半高 */\n      twist: 0.20,        /* 從頭到尾總共扭轉幾弧度（0 = 整條正面朝鏡頭） */\n      twist0: 0.00,       /* 整條再一起扭轉多少 */\n      flow0: 0.00,        /* 照片在布上的起始位移，單位是「格」 */\n      flowCells: 2.60,    /* 整段捲動下來，照片沿緞帶流過幾格 */\n      clipL: 0.12,        /* 左右垂直裁切框：只顯示畫面寬度這兩個比例之間的緞帶 */\n      clipR: 0.88,\n      splitZ: 0,          /* 前後分界：曲線座標裡的 z */\n      splitSoft: 0.14,    /* 分界的柔邊（畫面半寬的比例），跨界時交叉淡出不閃 */\n      shade: 0.10,        /* 長邊的淡暗邊，讓布有一點厚度 */\n      trackOff1: 1.45,    /* 軌道細線一：往側邊偏幾個緞帶寬 */\n      trackOff2: -1.70,   /* 軌道細線二 */\n      trackAlpha: 0.55,   /* 細線濃度 */\n      titleSpan: 1.42,    /* 兩行大標全程橫越幾個畫面寬 */\n      titleMid: 0.465,    /* 走到第幾成時剛好回到原本的版位 */\n      gridCards: 12,      /* 拼貼牆放幾張卡片 */\n      gridDist: 26,       /* 拼貼牆離鏡頭多遠 */\n      gridFov: 46,        /* 拼貼牆用回正常視角 */\n      gridScale: 1.0,\n      gridTilt: 0.05\n    };\n\nconst PF_T = {\n      titleSweepA: 0.00, titleSweepB: 0.92,   /* 大標橫越的起訖，中間不停 */\n      ringInA:  0.16, ringInB:  0.34,\n      showA:    0.42, showB:    0.62,\n      ringOutA: 0.55, ringOutB: 0.84,\n      morphA:   0.85, morphB:   1.00\n    };\n\nconst PF_KEYS = [\n      { p: 0.10, pts: [                         /* 還藏在畫面下方 */\n        [-2.05, -3.95, 0.85], [-1.15, -3.62, 0.30], [-0.30, -3.34, -0.55],\n        [ 0.55, -3.22, -1.45], [ 1.35, -3.30, -2.20], [ 2.10, -3.52, -2.90] ] },\n      { p: 0.26, pts: [                         /* 圖B：從左下沿弧線進場 */\n        [-2.05, -1.95, 0.85], [-1.15, -1.62, 0.30], [-0.30, -1.34, -0.55],\n        [ 0.55, -1.22, -1.45], [ 1.35, -1.30, -2.20], [ 2.10, -1.52, -2.90] ] },\n      { p: 0.36, pts: [                         /* 圖C：整條朝鏡頭翹起來 */\n        [-1.95, -0.88, -2.10], [-1.05, -0.38, -0.55], [-0.22, 0.10, 0.70],\n        [ 0.60, 0.04, 0.55], [ 1.35, -0.46, -1.25], [ 2.10, -0.98, -2.70] ] },\n      { p: 0.50, pts: [                         /* 圖D：主秀，左高右低 */\n        [-2.10, 0.80, -2.55], [-1.15, 0.50, -1.05], [-0.30, 0.14, 0.55],\n        [ 0.45, -0.30, 0.90], [ 1.25, -0.72, -1.05], [ 2.10, -1.08, -2.55] ] },\n      { p: 0.68, pts: [                         /* 圖E：往上甩，左低右高 */\n        [-2.05, -0.42, 0.80], [-1.10, 0.24, 0.35], [-0.28, 0.72, -0.70],\n        [ 0.55, 1.04, -1.60], [ 1.35, 1.20, -2.30], [ 2.10, 1.26, -2.95] ] },\n      { p: 0.82, pts: [                         /* 圖F：轉到上方往右上飛出 */\n        [-1.40, 1.02, 0.55], [-0.48, 1.34, -0.10], [ 0.40, 1.58, -0.95],\n        [ 1.28, 1.74, -1.75], [ 2.15, 1.80, -2.40], [ 3.00, 1.76, -3.00] ] },\n      { p: 0.95, pts: [                         /* 已經出框 */\n        [ 0.20, 2.42, 0.55], [ 1.12, 2.74, -0.10], [ 2.00, 2.98, -0.95],\n        [ 2.88, 3.14, -1.75], [ 3.75, 3.20, -2.40], [ 4.60, 3.16, -3.00] ] }\n    ];"
